{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": "var(--font-sans), ui-sans-serif, system-ui, -apple-system, sans-serif" },
      "mono": { "$value": "var(--font-mono), ui-monospace, SFMono-Regular, Menlo, monospace" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "semibold": { "$value": "600" },
      "bold": { "$value": "700" }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.8125rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "clamp(1.25rem, 1.15rem + 0.5vw, 1.375rem)" },
      "2xl": { "$value": "clamp(1.5rem, 1.3rem + 1vw, 1.75rem)" },
      "3xl": { "$value": "clamp(2rem, 1.5rem + 2.2vw, 2.5rem)" },
      "4xl": { "$value": "clamp(2.5rem, 1.7rem + 3.6vw, 3.5rem)" },
      "5xl": { "$value": "clamp(3rem, 1.9rem + 5vw, 5rem)" },
      "6xl": { "$value": "clamp(3.25rem, 1.8rem + 7vw, 7rem)" }
    },
    "leading": {
      "$type": "number",
      "none": { "$value": "1" },
      "tight": { "$value": "1.05" },
      "snug": { "$value": "1.15" },
      "normal": { "$value": "1.5" },
      "relaxed": { "$value": "1.6" }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "label": { "$value": "0.1em" },
      "wide": { "$value": "0.08em" },
      "editorial": { "$value": "0.12em" },
      "wider": { "$value": "0.14em" }
    }
  }
}
